{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "microfoodbr",
  "main": "worker.js",
  "compatibility_date": "2026-10-14",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "microfoodbr",
      "database_id": "f510d7b7-1e0b-4615-b489-fd6fe7a36b24"
    }
  ]
}
