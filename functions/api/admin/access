// Gera acesso SOMENTE quando o webhook do Mercado Pago confirmou pagamento aprovado.
const ITERATIONS=210000;
export async function onRequestPost(context){
 const {env,request}=context;
 if(!(await requireAdmin(env,request)))return json({error:'Não autorizado.'},401);
 let body;try{body=await request.json()}catch{return json({error:'Corpo inválido.'},400)}
 const merchantId=String(body.merchantId||'').trim();if(!merchantId)return json({error:'Informe o cadastro.'},400);
 const merchant=await env.DB.prepare('SELECT id,business_name,email FROM merchants WHERE id=?1').bind(merchantId).first();
 if(!merchant)return json({error:'Cadastro não encontrado.'},404);
 const subscription=await env.DB.prepare('SELECT status,paid_until FROM subscriptions WHERE merchant_id=?1').bind(merchantId).first();
 if(!subscription||subscription.status!=='active'){
  return json({error:'Bloqueado: não há pagamento aprovado confirmado pelo webhook do Mercado Pago. O retorno do checkout não libera acesso.'},409);
 }
 const email=(merchant.email||'').toLowerCase();
 if(!email)return json({error:'O cadastro não possui e-mail para criar o acesso.'},400);
 const temporary=generatePassword(),hash=await hashPassword(temporary);
 const existing=await env.DB.prepare('SELECT id FROM merchant_users WHERE merchant_id=?1').bind(merchantId).first();
 if(existing)await env.DB.prepare('UPDATE merchant_users SET email=?2,password_hash=?3,is_active=1,updated_at=datetime(\'now\') WHERE merchant_id=?1').bind(merchantId,email,hash).run();
 else await env.DB.prepare('INSERT INTO merchant_users (merchant_id,email,password_hash,is_active,created_at,updated_at) VALUES (?1,?2,?3,1,datetime(\'now\'),datetime(\'now\'))').bind(merchantId,email,hash).run();
 return json({merchantId,email,temporaryPassword:temporary,source:'mercadopago-webhook',note:'Acesso liberado por pagamento aprovado no webhook. Nenhuma cobrança foi criada.'});
}
function generatePassword(){const A='ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz23456789';const b=new Uint8Array(16);crypto.getRandomValues(b);return 'Mfbr-'+Array.from(b,x=>A[x%A.length]).join('')}
async function hashPassword(p){const salt=crypto.getRandomValues(new Uint8Array(16));const key=await crypto.subtle.importKey('raw',new TextEncoder().encode(p),'PBKDF2',false,['deriveBits']);const bits=await crypto.subtle.deriveBits({name:'PBKDF2',salt,iterations:ITERATIONS,hash:'SHA-256'},key,256);return['pbkdf2-sha256',ITERATIONS,b64(salt),b64(new Uint8Array(bits))].join('$')}
function b64(x){let s='';for(const b of x)s+=String.fromCharCode(b);return btoa(s)}
async function requireAdmin(env,request){const e=env.ADMIN_PASSPHRASE;if(!e)return false;const p=request.headers.get('x-admin-pass')||'';if(p.length!==e.length)return false;const a=new TextEncoder().encode(p),b=new TextEncoder().encode(e);let d=0;for(let i=0;i<a.length;i++)d|=a[i]^b[i];return d===0}
function json(data,status=200){return new Response(JSON.stringify(data),{status,headers:{'content-type':'application/json; charset=utf-8','cache-control':'no-store'}})}
